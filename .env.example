POSTGRES_USER=uj_ai_club
POSTGRES_PASSWORD=uj_ai_club_dev
POSTGRES_DB=uj_ai_club
POSTGRES_HOST=postgres
DATABASE_URL=postgres://uj_ai_club:uj_ai_club_dev@postgres:5432/uj_ai_club

SERVER_ADDRESS=0.0.0.0:8000
RUST_LOG=info
FIREBASE_PROJECT_ID=your-firebase-project-id
JWT_SECRET=
GRADING_SERVICE_SECRET=
# Optional separate secret for /internal/jupyterhub/* (falls back to GRADING_SERVICE_SECRET).
INTERNAL_SERVICE_SECRET=
NBGRADER_WEBHOOK_SECRET=
# Set APP_ENV=dev (or REQUIRE_STRONG_SECRETS=false) to allow short/placeholder secrets locally.
APP_ENV=dev
REQUIRE_STRONG_SECRETS=false
GRADING_SERVICE_URL=http://localhost:9100
JUPYTERHUB_URL=http://localhost:8888
JUPYTERHUB_API_URL=http://jupyterhub:8000
JUPYTERHUB_API_TOKEN=
# Required when JUPYTERHUB_ALLOW_DUMMY_AUTH=true (no default password).
JUPYTERHUB_DUMMY_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://uj-aiclub.com
FRONTEND_URL=http://localhost:3000

NOTEBOOKS_VOLUME_NAME=uj-ai-club-backend_uploads_data
NOTEBOOKS_HOST_PATH=
DOCKER_NETWORK_NAME=internal
STUDENT_ISOLATED_NETWORK_NAME=uj-ai-club-dev_students
JUPYTERHUB_HUB_CONNECT_IP=jupyterhub
JUPYTERHUB_ADMIN_USERS=
BACKEND_URL=http://host.docker.internal:8000
MAIN_APP_URL=http://localhost:3000
GRADING_WEBHOOK_URL=http://host.docker.internal:8000/webhooks/nbgrader/grade
JUPYTERHUB_USE_LEGACY_PRESPAWN_CMD=false
# Local development ONLY. When JWT_SECRET is unset, set this to true to allow the
# insecure DummyAuthenticator; otherwise JupyterHub refuses to start (fail closed).
# Also requires JUPYTERHUB_DUMMY_PASSWORD (no default).
JUPYTERHUB_ALLOW_DUMMY_AUTH=false
ADMIN_USERS_API=http://host.docker.internal:8000/users/profile

EXCHANGE_ROOT=/srv/nbgrader/exchange
COURSE_ID=ujaiclub
