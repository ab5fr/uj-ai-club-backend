# =============================================================================
# UJ AI Club — Backend environment
# Copy to .env and fill secrets. Loaded by api / jupyterhub / grading via Compose.
# Root docker-compose.dev.yml overrides some URLs for in-network Docker DNS.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (local Compose: service hostname "postgres")
# -----------------------------------------------------------------------------
POSTGRES_USER=uj_ai_club
POSTGRES_PASSWORD=uj_ai_club_dev
POSTGRES_DB=uj_ai_club
POSTGRES_HOST=postgres
# Prefer DATABASE_URL. If unset, API builds one from POSTGRES_* (password required).
DATABASE_URL=postgres://uj_ai_club:uj_ai_club_dev@postgres:5432/uj_ai_club
# Host-side `cargo run` (Postgres published on localhost:5432):
# DATABASE_URL=postgres://uj_ai_club:uj_ai_club_dev@localhost:5432/uj_ai_club

# -----------------------------------------------------------------------------
# Rust API
# -----------------------------------------------------------------------------
SERVER_ADDRESS=0.0.0.0:8000
RUST_LOG=info

# Required — Firebase project used to verify ID tokens
FIREBASE_PROJECT_ID=your-firebase-project-id

# Required — generate with: openssl rand -hex 32
JWT_SECRET=
# Required — grading service ↔ API shared secret (X-Grading-Service-Secret)
GRADING_SERVICE_SECRET=
# Required — nbgrader webhook HMAC / secret (non-empty)
NBGRADER_WEBHOOK_SECRET=

# Grading service base URL (Compose override: http://grading:9100)
GRADING_SERVICE_URL=http://localhost:9100

# Browser-facing JupyterHub URL (login redirects)
JUPYTERHUB_URL=http://localhost:8888
# Internal Hub API for stop-server / user lookup (Compose: http://jupyterhub:8000)
JUPYTERHUB_API_URL=http://jupyterhub:8000
# Required for Hub API calls
JUPYTERHUB_API_TOKEN=

# Comma-separated browser origins for CORS (default if unset: http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://uj-aiclub.com

# Unused by current Rust code (kept for Compose/docs compatibility)
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# JupyterHub
# -----------------------------------------------------------------------------
# Named Docker volume with challenge notebooks (Compose overrides in docker-compose.dev.yml)
NOTEBOOKS_VOLUME_NAME=uj-ai-club-backend_uploads_data
# Optional host bind instead of named volume (leave empty to use NOTEBOOKS_VOLUME_NAME)
NOTEBOOKS_HOST_PATH=

# Spawner network (Compose override: uj-ai-club-dev_internal)
DOCKER_NETWORK_NAME=internal
# Isolated no-egress network when challenge has networkDisabled (Compose: uj-ai-club-dev_students)
STUDENT_ISOLATED_NETWORK_NAME=uj-ai-club-dev_students

# Hub container DNS name for single-user connect (prod Compose sets this)
JUPYTERHUB_HUB_CONNECT_IP=jupyterhub

# Comma-separated JupyterHub admin usernames (usually admin_<uuid> style, or emails if configured)
JUPYTERHUB_ADMIN_USERS=

# API base URL as seen from JupyterHub (token + spawn validation)
# Compose override: http://api:8000
BACKEND_URL=http://api:8000

# Redirect target when /hub/login has no JWT
MAIN_APP_URL=http://localhost:3000

# Webhook target after nbgrader finishes (Compose override: http://api:8000/...)
GRADING_WEBHOOK_URL=http://api:8000/webhooks/nbgrader/grade

# Opt-in legacy student container start command (default false)
JUPYTERHUB_USE_LEGACY_PRESPAWN_CMD=false

# Unused by current Python/Rust code (Compose may still set it)
ADMIN_USERS_API=http://api:8000/users/profile

# -----------------------------------------------------------------------------
# Grading service
# -----------------------------------------------------------------------------
EXCHANGE_ROOT=/srv/nbgrader/exchange
COURSE_ID=ujaiclub
DOCKER_SOCKET=/var/run/docker.sock
GRADING_SERVICE_PORT=9100

# -----------------------------------------------------------------------------
# Production Compose image tags (docker-compose.prod.yml only; optional)
# -----------------------------------------------------------------------------
# API_IMAGE=ghcr.io/your-org/uj-ai-club-backend:latest
# JUPYTERHUB_IMAGE=ghcr.io/your-org/uj-ai-club-jupyterhub:latest
# GRADING_IMAGE=ghcr.io/your-org/uj-ai-club-grading:latest
