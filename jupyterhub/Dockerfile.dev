# Dev image: same as production JupyterHub, plus auto-restart on Python/config changes.
FROM jupyterhub/jupyterhub:5.5.0

USER root

RUN pip install --no-cache-dir \
    dockerspawner==12.* \
    jupyterhub-idle-culler \
    nbgrader==0.9.* \
    PyJWT>=2.0.0 \
    requests \
    watchdog

RUN mkdir -p /srv/jupyterhub /data /srv/nbgrader/exchange \
    && chmod 777 /srv/nbgrader/exchange

COPY jupyterhub_config.py /srv/jupyterhub/jupyterhub_config.py
COPY custom_authenticator.py /srv/jupyterhub/custom_authenticator.py
COPY nbgrader_config_hub.py /etc/jupyter/nbgrader_config.py

WORKDIR /srv/jupyterhub

EXPOSE 8000

VOLUME ["/data", "/srv/nbgrader/exchange"]

# Polling is required for bind mounts on Docker Desktop (Windows/macOS).
ENV WATCHDOG_FORCE_POLLING=true

CMD ["watchmedo", "auto-restart", \
     "--directory=/srv/jupyterhub", \
     "--directory=/etc/jupyter", \
     "--patterns=*.py", \
     "--recursive", \
     "--debounce-interval=1", \
     "--", \
     "jupyterhub", "-f", "/srv/jupyterhub/jupyterhub_config.py"]
