# Development image: cargo watch rebuilds + restarts on source changes.
FROM rust:1-bookworm

RUN cargo install cargo-watch --locked

WORKDIR /app

ENV CARGO_TERM_COLOR=always
ENV RUST_LOG=info
ENV SERVER_ADDRESS=0.0.0.0:8000

EXPOSE 8000

# --clear: show full rebuild output; --poll: required for bind mounts on Docker Desktop/Windows
CMD ["cargo-watch", "--poll", "-w", "src", "-w", "Cargo.toml", "-w", "Cargo.lock", "-w", "migrations", "-x", "run"]
